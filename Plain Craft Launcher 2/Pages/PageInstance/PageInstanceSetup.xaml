<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:loc="https://ce.pclc.cc/core/localization"
    xmlns:val="https://ce.pclc.cc/core/utils/validate"
    x:Class="PCL.PageInstanceSetup"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Margin="0,15,0,15" Title="{loc:Loc Horizon.Instance.Setup.Build.Title}">
                <StackPanel Margin="25,40,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{loc:Loc Horizon.Instance.Setup.Build.Label}" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboBuild" Grid.Column="1" Height="28"
                                          SelectionChanged="ComboBuild_SelectionChanged" />
                    </Grid>
                    <TextBlock Text="{loc:Loc Horizon.Instance.Setup.Build.Hint}" TextWrapping="Wrap" Opacity="0.6"
                               Margin="0,8,0,0" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{loc:Loc Horizon.Instance.Setup.Window.Title}">
                <StackPanel Margin="25,40,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{loc:Loc Horizon.Instance.Setup.Window.Size}" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextWidth" Grid.Column="1" Height="28" TextChanged="WindowSize_TextChanged">
                            <local:MyTextBox.ValidateRules>
                                <val:IntValidator Min="320" Max="16384" />
                            </local:MyTextBox.ValidateRules>
                        </local:MyTextBox>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="×" Margin="10,0" />
                        <local:MyTextBox x:Name="TextHeight" Grid.Column="3" Height="28" TextChanged="WindowSize_TextChanged">
                            <local:MyTextBox.ValidateRules>
                                <val:IntValidator Min="240" Max="16384" />
                            </local:MyTextBox.ValidateRules>
                        </local:MyTextBox>
                    </Grid>
                    <local:MyCheckBox x:Name="CheckFullscreen" Margin="0,12,0,0" Height="22"
                                      Text="{loc:Loc Horizon.Instance.Setup.Window.Fullscreen}"
                                      Change="CheckFullscreen_Change" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
