<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:loc="https://ce.pclc.cc/core/localization"
    x:Class="PCL.PageInstanceOverall"
    PanScroll="{Binding ElementName=PanBack}" Grid.IsSharedSizeScope="True">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15">
                <local:MyListItem x:Name="ItemHeader" Margin="10,7" Height="42" Type="None"
                                  Logo="pack://application:,,,/images/Blocks/Grass.png" />
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{loc:Loc Instance.Overall.Info.Title}">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock x:Name="LabBuild" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock x:Name="LabFolder" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{loc:Loc Instance.Overall.Shortcuts.Title}">
                <WrapPanel Margin="25,35,5,15">
                    <local:MyButton Text="{loc:Loc Instance.Overall.Shortcuts.InstanceFolder}" MinWidth="140" Padding="13,0"
                                    Height="35" Margin="0,7,20,0" Click="BtnFolderInstance_Click" />
                    <local:MyButton Text="{loc:Loc Instance.Overall.Shortcuts.SavesFolder}" MinWidth="140" Padding="13,0"
                                    Height="35" Margin="0,7,20,0" Click="BtnFolderSaves_Click" />
                    <local:MyButton Text="{loc:Loc Horizon.Instance.Overall.ScreenshotsFolder}" MinWidth="140" Padding="13,0"
                                    Height="35" Margin="0,7,20,0" Click="BtnFolderScreenshots_Click" />
                    <local:MyButton Text="{loc:Loc Horizon.Instance.Overall.LogsFolder}" MinWidth="140" Padding="13,0"
                                    Height="35" Margin="0,7,20,0" Click="BtnFolderLogs_Click" />
                </WrapPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{loc:Loc Instance.Overall.Manage.Title}">
                <WrapPanel Margin="25,35,5,15">
                    <local:MyButton Text="{loc:Loc Instance.Overall.Manage.TestGame}" MinWidth="140" Padding="13,0"
                                    Height="35" Margin="0,7,20,0" ColorType="Highlight" Click="BtnLaunch_Click" />
                    <local:MyButton Text="{loc:Loc Instance.Overall.Rename}" MinWidth="140" Padding="13,0"
                                    Height="35" Margin="0,7,20,0" Click="BtnRename_Click" />
                    <local:MyButton Text="{loc:Loc Horizon.Instance.Overall.OpenLatestLog}" MinWidth="140" Padding="13,0"
                                    Height="35" Margin="0,7,20,0" Click="BtnLatestLog_Click" />
                    <local:MyButton Text="{loc:Loc Instance.Overall.Manage.Delete}" MinWidth="140" Padding="13,0"
                                    Height="35" Margin="0,7,20,0" ColorType="Red" Click="BtnDelete_Click" />
                </WrapPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
