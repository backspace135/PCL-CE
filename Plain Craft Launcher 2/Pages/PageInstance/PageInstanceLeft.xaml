<local:MyPageLeft x:Class="PCL.PageInstanceLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL" AnimatedControl="{Binding ElementName=PanItem, Mode=OneWay}"
                  xmlns:loc="https://ce.pclc.cc/core/localization">
    <local:MyScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource ScrollViewerFullMargin}">
        <StackPanel Margin="0,12,0,0" x:Name="PanItem">
            <TextBlock Text="{loc:Loc Instance.Left.Game}" Margin="13,6,5,4" Opacity="0.6" FontSize="12" />
            <local:MyListItem x:Name="ItemOverall" IsScaleAnimationEnabled="False" Checked="True" Type="RadioBox"
                              Check="PageCheck"
                              Tag="0" MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="{loc:Loc Instance.Left.Overview}"
                              SvgIcon="lucide/layout-dashboard" />
            <local:MyListItem x:Name="ItemSetup" IsScaleAnimationEnabled="False" Tag="1" MinPaddingRight="35"
                              Check="PageCheck"
                              Height="36" VerticalAlignment="Top" Title="{loc:Loc Instance.Left.Settings}"
                              Type="RadioBox"
                              SvgIcon="lucide/settings" />
            <TextBlock x:Name="TextResource" Text="{loc:Loc Instance.Left.Resources}" Margin="13,6,5,4"
                       Visibility="{Binding TextResourceVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Opacity="0.6" FontSize="12" />
            <local:MyListItem x:Name="ItemWorld" LogoScale="0.95" IsScaleAnimationEnabled="False" Type="RadioBox"
                              Check="PageCheck"
                              MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="{loc:Loc Instance.Left.Saves}" Tag="3"
                              Visibility="{Binding ItemWorldVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              SvgIcon="lucide/globe">
                <local:MyListItem.Buttons>
                    <x:Array Type="{x:Type local:MyIconButton}">
                        <local:MyIconButton Tag="3" ToolTip="{loc:Loc Common.Action.Refresh}"
                                            ToolTipService.Placement="Right"
                                            ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1"
                                            LogoScale="0.85"
                                            Command="{Binding RefreshButtonCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            SvgIcon="lucide/refresh-cw" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
            <local:MyListItem x:Name="ItemScreenshot" LogoScale="0.95" IsScaleAnimationEnabled="False" Type="RadioBox"
                              Check="PageCheck"
                              MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="{loc:Loc Instance.Left.Screenshots}" Tag="4"
                              Visibility="{Binding ItemScreenshotVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              SvgIcon="lucide/image">
                <local:MyListItem.Buttons>
                    <x:Array Type="{x:Type local:MyIconButton}">
                        <local:MyIconButton Tag="4" ToolTip="{loc:Loc Common.Action.Refresh}"
                                            ToolTipService.Placement="Right"
                                            ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1"
                                            LogoScale="0.85"
                                            Command="{Binding RefreshButtonCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            SvgIcon="lucide/refresh-cw" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
            <local:MyListItem x:Name="ItemMod" LogoScale="0.85" IsScaleAnimationEnabled="False"
                              Check="PageCheck"
                              Type="RadioBox" MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="{loc:Loc Horizon.Instance.Left.Mods}"
                              Tag="5"
                              Visibility="{Binding ItemModVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              SvgIcon="lucide/puzzle">
                <local:MyListItem.Buttons>
                    <x:Array Type="{x:Type local:MyIconButton}">
                        <local:MyIconButton Tag="5" ToolTip="{loc:Loc Common.Action.Refresh}"
                                            ToolTipService.Placement="Right"
                                            ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1"
                                            LogoScale="0.85"
                                            Command="{Binding RefreshButtonCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            SvgIcon="lucide/refresh-cw" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
            <local:MyListItem x:Name="ItemResourcePack" LogoScale="0.85" IsScaleAnimationEnabled="False"
                              Check="PageCheck"
                              Type="RadioBox" MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="{loc:Loc Instance.Left.ResourcePacks}"
                              Tag="7"
                              Visibility="{Binding ItemResourcePackVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              SvgIcon="lucide/layers">
                <local:MyListItem.Buttons>
                    <x:Array Type="{x:Type local:MyIconButton}">
                        <local:MyIconButton Tag="7" ToolTip="{loc:Loc Common.Action.Refresh}"
                                            ToolTipService.Placement="Right"
                                            ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1"
                                            LogoScale="0.85"
                                            Command="{Binding RefreshButtonCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            SvgIcon="lucide/refresh-cw" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
            <local:MyListItem x:Name="ItemShader" LogoScale="0.85" IsScaleAnimationEnabled="False"
                              Check="PageCheck"
                              Type="RadioBox" MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="{loc:Loc Horizon.Instance.Left.Shaders}"
                              Tag="8"
                              Visibility="{Binding ItemShaderVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              SvgIcon="lucide/sparkles">
                <local:MyListItem.Buttons>
                    <x:Array Type="{x:Type local:MyIconButton}">
                        <local:MyIconButton Tag="8" ToolTip="{loc:Loc Common.Action.Refresh}"
                                            ToolTipService.Placement="Right"
                                            ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1"
                                            LogoScale="0.85"
                                            Command="{Binding RefreshButtonCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            SvgIcon="lucide/refresh-cw" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
            <local:MyListItem x:Name="ItemServer" LogoScale="0.85" IsScaleAnimationEnabled="False" Type="RadioBox"
                              Check="PageCheck"
                              MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="{loc:Loc Instance.Left.Servers}" Tag="11"
                              Visibility="{Binding ItemServerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              SvgIcon="lucide/server">
                <local:MyListItem.Buttons>
                    <x:Array Type="{x:Type local:MyIconButton}">
                        <local:MyIconButton Tag="11" ToolTip="{loc:Loc Common.Action.Refresh}"
                                            ToolTipService.Placement="Right"
                                            ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1"
                                            LogoScale="0.85"
                                            Command="{Binding RefreshButtonCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            SvgIcon="lucide/refresh-cw" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageLeft>