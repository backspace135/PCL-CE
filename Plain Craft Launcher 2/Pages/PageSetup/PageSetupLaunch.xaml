<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:loc="https://ce.pclc.cc/core/localization"
    x:Class="PCL.PageSetupLaunch"
    PanScroll="{Binding ElementName=PanBack, Mode=OneWay}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Margin="0,0,0,15" Title="{loc:Loc Setup.Launch.Options.Title}">
                <StackPanel Margin="25,40,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{loc:Loc Setup.Launch.Options.Visibility.Label}" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboVisibility" Grid.Column="1" Height="28"
                                          SelectionChanged="ComboVisibility_SelectionChanged">
                            <local:MyComboBoxItem Content="{loc:Loc Setup.Launch.Options.Visibility.CloseImmediately}" />
                            <local:MyComboBoxItem Content="" IsEnabled="False" Visibility="Collapsed" />
                            <local:MyComboBoxItem Content="{loc:Loc Setup.Launch.Options.Visibility.HideAndCloseOnExit}" />
                            <local:MyComboBoxItem Content="{loc:Loc Setup.Launch.Options.Visibility.HideAndReopenOnExit}" />
                            <local:MyComboBoxItem Content="{loc:Loc Setup.Launch.Options.Visibility.Minimize}" />
                            <local:MyComboBoxItem Content="{loc:Loc Setup.Launch.Options.Visibility.KeepUnchanged}" />
                        </local:MyComboBox>
                    </Grid>
                    <local:MyCheckBox x:Name="CheckGpuPreference" Margin="0,12,0,0" Height="22"
                                      Text="{loc:Loc Setup.Launch.Advanced.GpuPreference}"
                                      Change="CheckGpuPreference_Change" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{loc:Loc Horizon.Setup.Data.Title}">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock x:Name="LabRoot" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Horizon.Setup.Data.Hint}" TextWrapping="Wrap" Opacity="0.6" Margin="0,8,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <local:MyButton Text="{loc:Loc Horizon.Setup.Data.Open}" MinWidth="140" Padding="13,0" Height="35"
                                        Margin="0,0,20,0" ColorType="Highlight" Click="BtnOpenRoot_Click" />
                        <local:MyButton Text="{loc:Loc Horizon.Setup.Data.Change}" MinWidth="140" Padding="13,0" Height="35"
                                        Margin="0,0,20,0" Click="BtnChangeRoot_Click" />
                        <local:MyButton Text="{loc:Loc Common.Action.Reset}" MinWidth="140" Padding="13,0" Height="35"
                                        Margin="0,0,20,0" Click="BtnResetRoot_Click" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
