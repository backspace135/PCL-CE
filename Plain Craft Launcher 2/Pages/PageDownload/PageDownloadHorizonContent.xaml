<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:loc="https://ce.pclc.cc/core/localization"
    x:Class="PCL.PageDownloadHorizonContent"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,25,25,10">
            <local:MySearchBox x:Name="PanSearchBox" Margin="0,0,0,15" HintText="{loc:Loc Horizon.Content.Search.Hint}"
                               TextChanged="PanSearchBox_TextChanged" />
            <local:MyCard Margin="0,0,0,15">
                <Grid Margin="20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc Horizon.Content.Filter.Kind}" Margin="0,0,15,0" />
                    <local:MyComboBox x:Name="ComboKind" Grid.Column="1" Height="28" SelectionChanged="ComboKind_SelectionChanged">
                        <local:MyComboBoxItem Content="{loc:Loc Horizon.Content.Kind.All}" IsSelected="True" />
                        <local:MyComboBoxItem Content="{loc:Loc Horizon.Content.Kind.Mod}" />
                        <local:MyComboBoxItem Content="{loc:Loc Horizon.Content.Kind.Shader}" />
                        <local:MyComboBoxItem Content="{loc:Loc Horizon.Content.Kind.ResourcePack}" />
                        <local:MyComboBoxItem Content="{loc:Loc Horizon.Content.Kind.Datapack}" />
                    </local:MyComboBox>
                    <local:MyCheckBox x:Name="CheckCompatibleOnly" Grid.Column="2" Margin="20,0,0,0" Height="22"
                                      Checked="True" Text="{loc:Loc Horizon.Content.Filter.CompatibleOnly}"
                                      Change="CheckCompatibleOnly_Change" />
                </Grid>
            </local:MyCard>
            <local:MyHint x:Name="HintTarget" Theme="Blue" Margin="0,0,0,15" />
            <local:MyHint x:Name="HintStatus" Theme="Blue" Margin="0,0,0,15" />
            <local:MyCard x:Name="CardList" Margin="0,0,0,15">
                <StackPanel x:Name="PanList" Margin="12,38,12,12" />
            </local:MyCard>
            <TextBlock Text="{loc:Loc Horizon.Content.Hint}" TextWrapping="Wrap" Opacity="0.6" Margin="5,0" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
